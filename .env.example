# These names stay fixed across providers. Local defaults need no API key.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:4b-q4_K_M
LLM_API_KEY=
# Leave unset for automatic local/Docker defaults. For a hosted provider,
# configure its HTTPS API base URL, model and key together.
# LLM_BASE_URL=http://127.0.0.1:11434
